<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fully offline app: no INTERNET permission, no storage permissions.
         Image selection uses ACTION_GET_CONTENT (SAF), which needs no permission,
         and the chosen image is copied into app-private internal storage. -->

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SecondActivity" />
        <activity android:name=".RegistrationActivity" />
        <activity android:name=".PasswordActivity" />
        <activity android:name=".ProfileActivity" />
        <activity android:name=".UpdateProfile" />
        <activity android:name=".Q1"/>
        <activity android:name=".Q2"/>
        <activity android:name=".Q3"/>
        <activity android:name=".Q4"/>
        <activity android:name=".Q5"/>
        <activity android:name=".A1"/>
        <activity android:name=".A2"/>
        <activity android:name=".A3"/>
        <activity android:name=".A4"/>
        <activity android:name=".A5"/>
        <activity android:name=".Exit"/>
        <activity android:name=".Tans"/>
        <activity android:name=".Underdep"/>
        <activity android:name=".UpdatePassword"></activity>
    </application>

</manifest>